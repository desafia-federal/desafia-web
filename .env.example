# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://desafiafederal.org

# Optional server-side webhook for contact and participation forms.
# It receives JSON with name, email, province, subject and message.
CONTACT_WEBHOOK_URL=

# Optional checkout links. Keep them empty until the association is legally
# constituted and the payment accounts are verified.
DONATION_URL_ARS_ONCE=
DONATION_URL_ARS_MONTHLY=
DONATION_URL_USD_ONCE=
DONATION_URL_USD_MONTHLY=

# Mercado Pago (cena a beneficio en /participar).
# Access token from your Mercado Pago application (Checkout Pro).
MP_ACCESS_TOKEN=
# Secret used to validate the x-signature header of incoming webhooks.
MP_WEBHOOK_SECRET=

# Persistent store for the "benefactores iniciales" list.
# Set these to use an Upstash-compatible Redis REST store (recommended on
# serverless hosts like Vercel). When empty, names are saved to a local
# .data/benefactors.json file, which only persists on hosts with a writable
# filesystem.
KV_REST_API_URL=
KV_REST_API_TOKEN=
