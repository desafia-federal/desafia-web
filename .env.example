# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://desafiafederal.org

# Optional server-side webhook for contact and participation forms.
# It receives JSON with name, email, province, subject and message.
CONTACT_WEBHOOK_URL=

# Checkout Pro for the fundraising dinner. Create an application in Mercado
# Pago, use its production Access Token here and copy the Webhooks secret after
# registering https://YOUR_DOMAIN/api/mercado-pago/webhook for payment events.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Durable, idempotent registry of approved benefactors. The implementation
# accepts either the Upstash names or the equivalent Vercel KV names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional checkout links. Keep them empty until the association is legally
# constituted and the payment accounts are verified.
DONATION_URL_ARS_ONCE=
DONATION_URL_ARS_MONTHLY=
DONATION_URL_USD_ONCE=
DONATION_URL_USD_MONTHLY=
